*.log

# Backups produced by the installer
*.bak
*.bak.*

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store

# Downloaded artefacts the installer fetches at runtime
/tmp_downloads/
*.deb
*.zip
*.tar.gz
